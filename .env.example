# Muenot Publishing — environment variable NAMES only. Never commit real values.
# Shared ERP infrastructure (database, storage, auth, AI gateway) also needs its
# own variables; see the ERP ENV_VARIABLES.txt for those.
AI_GATEWAY_API_KEY=
# How long a batch waits for AI credits before pausing
ALT_TEXT_CREDIT_WAIT_SECONDS=
# Queue-wide running cap for alt_text.batch_processing jobs
ALT_TEXT_GLOBAL_MAX_CONCURRENCY=
# Max retries for provider configuration errors
ALT_TEXT_MAX_CONFIG_RETRIES=
# Max attempts per image before it is marked failed
ALT_TEXT_MAX_IMAGE_ATTEMPTS=
# Base backoff for image retries
ALT_TEXT_RETRY_BASE_SECONDS=
# Max backoff for image retries
ALT_TEXT_RETRY_MAX_SECONDS=
# Per-tenant concurrent image cap
ALT_TEXT_TENANT_MAX_CONCURRENCY=
# Fallback vision provider key used by lib/alt-text/vision-service (ERP normally resolves providers via lib/ai/provider)
OPENAI_API_KEY=
