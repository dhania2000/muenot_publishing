# Hostinger -> Deployments -> Environment variables -> Import .env
# Fill in the values, then import. Do NOT commit real secrets to GitHub.

# --- Required ---
NODE_ENV=production
APP_URL=https://publishing.muenot.co.in

# MySQL (used by lib/db.ts) — format: mysql://USER:PASSWORD@HOST:3306/DB_NAME
# Use ?ssl=false if your Hostinger MySQL does not support SSL
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME?ssl=false

# MySQL (used by _erp-shared/lib/db.ts — auth/shared modules). Same database as above.
DB_HOST=HOST
DB_PORT=3306
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_NAME=DB_NAME
DB_SSL=false
DB_SSL_CA=
DB_DISABLE_KEEPALIVE=false

# Protects /api/jobs/run (generate any long random string)
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Muenot Services <no-reply@muenot.co.in>

# --- AI (set at least one key; Vercel AI Gateway auth is not automatic on Hostinger) ---
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_MODEL_PROVIDERS=openai
AI_DEFAULT_MODEL=
AI_FALLBACK_MODEL=
AI_ALLOWED_MODELS=
AI_MONTHLY_CREDIT_LIMIT=
AI_DISABLED=false

# --- Uploads / storage (optional) ---
MAX_UPLOAD_MB=50
STORAGE_QUOTA_GB=0
STORAGE_SCAN_TIMEOUT_MS=30000
